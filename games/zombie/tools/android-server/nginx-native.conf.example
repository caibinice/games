# Include inside the existing HTTPS server only after nginx -t succeeds.
# This location is independent from /games/ and contains no capability secret.
location ^~ /native-zombie/ {
    proxy_pass http://127.0.0.1:53175/;
    proxy_http_version 1.1;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection "upgrade";
    proxy_set_header Host $host;
    proxy_connect_timeout 3s;
    proxy_send_timeout 10s;
    proxy_read_timeout 75s;
    client_max_body_size 64k;
    proxy_buffering off;
    access_log off;
    error_log /var/log/nginx/native-zombie-error.log crit;
    add_header Cache-Control "no-store" always;
    add_header X-Content-Type-Options nosniff always;
    add_header Strict-Transport-Security "max-age=15552000" always;
    add_header X-Frame-Options SAMEORIGIN always;
    add_header Referrer-Policy no-referrer always;
    add_header Permissions-Policy "camera=(), microphone=(), geolocation=()" always;
}

# Only randomly named signed APK files belong here; no configuration or keys.
location ^~ /native-zombie-install/ {
    alias /opt/zombie-native/downloads/;
    autoindex off;
    types { application/vnd.android.package-archive apk; }
    default_type application/octet-stream;
    limit_rate 4m;
    access_log off;
    error_log /var/log/nginx/native-zombie-error.log crit;
    add_header Content-Disposition "attachment" always;
    add_header Cache-Control "no-store" always;
    add_header Strict-Transport-Security "max-age=15552000" always;
    add_header X-Content-Type-Options nosniff always;
    add_header Referrer-Policy no-referrer always;
}
